# ===== OpenObserve 连接（必填）=====
# 复制本文件为 .env 后填写。所有脚本/文档只读这一个来源。
OO_BASE_URL=http://localhost:5080
OO_ORG=default
OO_EMAIL=root@example.com        # 自托管登录邮箱 = API 账号
OO_PASSWORD=ChangeMe             # 你的登录密码
# ===== 可选微调 =====
OO_HTTP_TIMEOUT=30               # 单请求超时（秒）
OO_BATCH_LOGS=400                # 每次 _json 灌入的日志条数上限
OO_VERBOSE=0                     # 1=打印每步 API 明细（排障用）
