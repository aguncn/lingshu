# 灵枢环境变量示例：复制为 .env 并按需填写（.env 已被 gitignore，勿提交真实值）。
# 后端 config.py 会在启动时读取；未设置时使用内置默认值。

# Fernet 主密钥（密钥加密基础）。生成示例：
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 本参数在 P10 security-audit 落地密钥加密时启用；现在留空即可。
LINGSHU_MASTER_KEY=

# 数据目录（sqlite + 落盘文件）。缺省为 backend/data。
LINGSHU_DATA_DIR=

# CORS 允许来源（逗号分隔）。开发态默认放行 Vite 的 5173。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
